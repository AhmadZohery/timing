# ==============================================================================
# مضمار | Midmar LifeOS - Production Environment Variables Template
# ==============================================================================
# Security Rule: Never prefix backend secrets with VITE_ to keep client bundles 100% clean.

# Server Port (Default: 80 in Docker, 3000 in standalone Node)
PORT=80
NODE_ENV=production

# Persistent Data Storage Directory (JSON backup & file persistence)
DATA_DIR=./data

# PostgreSQL Database URL (Optional: If omitted, Midmar runs in robust local file-storage mode)
# Example: postgresql://midmar:midmar_secret_password_2026@postgres:5432/midmar
DATABASE_URL=

# Server API Security Secret (Recommended in production to secure server sync endpoints)
SERVER_API_SECRET=

# AI Cloud Engine Proxy Keys (Server-side only - client never sees these keys)
# Obtain from https://platform.deepseek.com or https://aistudio.google.com
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
